{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "dearlive-games-superadmin",
  "outputDirectory": "public",
  "installCommand": "echo 'static frontend: no dependencies'",
  "buildCommand": "echo 'static frontend: no build step'",
  "regions": ["iad1"],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://dearlive-games.vercel.app/api/:path*" },
    { "source": "/superadmin/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
