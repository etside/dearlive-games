{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "dearlive-games-player",
  "outputDirectory": "public",
  "installCommand": "echo 'static frontend: no dependencies'",
  "buildCommand": "echo 'static frontend: no build step'",
  "regions": ["iad1"],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://dearlive-games.vercel.app/api/:path*" },
    { "source": "/teen-patti-pro", "destination": "https://dearlive-games.vercel.app/teen-patti-pro/" },
    { "source": "/teen-patti-pro/:path*", "destination": "https://dearlive-games.vercel.app/teen-patti-pro/:path*" },
    { "source": "/greedy-lion", "destination": "https://dearlive-games.vercel.app/greedy-lion/" },
    { "source": "/greedy-lion/:path*", "destination": "https://dearlive-games.vercel.app/greedy-lion/:path*" },
    { "source": "/greedy-monkey", "destination": "https://dearlive-games.vercel.app/greedy-monkey/" },
    { "source": "/greedy-monkey/:path*", "destination": "https://dearlive-games.vercel.app/greedy-monkey/:path*" },
    { "source": "/monkey-wheel", "destination": "https://dearlive-games.vercel.app/monkey-wheel/" },
    { "source": "/monkey-wheel/:path*", "destination": "https://dearlive-games.vercel.app/monkey-wheel/:path*" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
