# DearLive Games — environment template. Copy to .env.local (dev) or inject via
# secrets manager (staging/prod). NEVER commit filled values. See docs/dearlive-request.md.
# --- Environment ---
# sandbox = local/mock adapters (dev only). staging/production = real
# DearLive APIs + Redis + Postgres. Production refuses to boot when
# required values are missing (see common/config.py).
APP_ENV=sandbox
# --- DearLive staging (CLIENT-PROVIDED, staging only) ---
DEARLIVE_API_BASE_URL=
DEARLIVE_AUTH_TYPE=Bearer
DEARLIVE_CLIENT_ID=
DEARLIVE_CLIENT_SECRET=
DEARLIVE_API_KEY=
# --- Redis launch-token contract ---
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
TOKEN_KEY_PREFIX=dearlive:launch:
TOKEN_TTL_MS=120000
# --- Wallet / webhooks ---
# WALLET_BASE_URL falls back to DEARLIVE_API_BASE_URL when empty.
WALLET_BASE_URL=
WALLET_API_KEY=
WALLET_CLIENT_ID=
WALLET_CLIENT_SECRET=
WALLET_TIMEOUT_MS=8000
COIN_CURRENCY=COIN
WEBHOOK_SECRET=
WEBHOOK_SIGNING_METHOD=HMAC-SHA256
SETTLEMENT_WEBHOOK_URL=
SETTLEMENT_SIGNING_SECRET=
# --- Game-side Postgres (records only — NEVER wallet balances) ---
DATABASE_URL=
# --- Games / admin (dev defaults safe) ---
GAMES_BASE_URL=http://127.0.0.1:5002
GAME_API_HOST=127.0.0.1
GAME_API_PORT=5002
GAME_WS_PORT=5003
# GAME_ADMIN_KEYS=key1:admin,key2:superadmin (production requires this;
# single GAME_ADMIN_KEY still accepted for local dev)
# Roles (hierarchy superadmin > admin > operator > auditor): auditor reads
# admin endpoints; operator also runs round start/close/result/settle; admin
# is the general operator role; superadmin alone may PUT game config.
# e.g. GAME_ADMIN_KEYS=op-key-1:operator,ro-key-1:auditor,admin-key:admin,super-key:superadmin
GAME_ADMIN_KEY=
GAME_ADMIN_KEYS=
JEV_URL=http://127.0.0.1:8081
JEV_API_KEY=local-dev
